{
  "name": "@pimcore/data-hub",
  "version": "0.0.1",
  "scripts": {
    "dev": "NODE_ENV=development rsbuild build",
    "dev-server": "NODE_ENV=dev-server rsbuild dev",
    "build": "rsbuild build",
    "lint": "eslint ./js",
    "lint-fix": "eslint ./js --fix",
    "lint-fix-watch": "nodemon --watch './js/**/*' --exec \"eslint ./js --fix --cache\" -e js,jsx,ts,tsx",
    "check-types": "tsc --noEmit",
    "check-types-watch": "tsc --noEmit --watch",
    "build-api-client": "TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node\"}' npx @rtk-query/codegen-openapi ./build/api/openapi-config.ts",
    "generate-types": "tsc && tsc-alias"
  },
  "exports": {
    ".": {
      "types": "./dist/build/types/sdk/index.d.ts"
    },
    "./*": {
      "types": "./dist/build/types/sdk/*/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pimcore/data-hub"
  },
  "keywords": [
    "pimcore",
    "pimcore-studio-ui",
    "pimcore-data-hub"
  ],
  "files": [
    "dist"
  ],
  "license": "proprietary",
  "devDependencies": {
    "@eslint/js": "^9",
    "@module-federation/rsbuild-plugin": "^2.2.3",
    "@rsbuild/core": "^1.3.21",
    "@rsbuild/plugin-react": "^1.3.1",
    "@rtk-query/codegen-openapi": "^1.2.0",
    "@stylistic/eslint-plugin": "^4",
    "@types/react-dom": "18.3.x",
    "@types/webpack-env": "^1.18.4",
    "eslint": "^9",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-n": "^17",
    "eslint-plugin-promise": "^7",
    "eslint-plugin-react": "^7.33.2",
    "globals": "^16",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@pimcore/studio-ui-bundle": "1.0.0-canary.20260401-093649-e21cdda",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "axios": "1.13.6"
  }
}
